# anthropic-prospector configuration.
#
# Every value here is OPTIONAL. With nothing set, the CLI runs end-to-end in mock mode
# (deterministic fixtures + mock LLM), and every output is labelled DATA: MOCK.
# Public sources (ATS boards, company pages, DNS) never need a key.
# Copy to `.env` or export the variables in your shell.

# --- LLM ---------------------------------------------------------------------------
# Enables the live Claude path for narrative and scorecard refinement.
ANTHROPIC_API_KEY=
# Model used by the tool itself (default: claude-sonnet-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Runtime -----------------------------------------------------------------------
# HTTP response cache (default: $XDG_CACHE_HOME or ~/.cache, then /anthropic-prospector).
PROSPECTOR_CACHE_DIR=
# Hours before a cached response is fetched again.
PROSPECTOR_CACHE_TTL_HOURS=24
# Max concurrent outbound requests across all hosts, and per host.
PROSPECTOR_HTTP_CONCURRENCY=5
PROSPECTOR_PER_HOST_CONCURRENCY=2
# HTTP timeouts, in seconds.
PROSPECTOR_HTTP_CONNECT_TIMEOUT_S=5
PROSPECTOR_HTTP_READ_TIMEOUT_S=15
